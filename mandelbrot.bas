170 C$ = ".,'~[/<*?&O0X# ": REM ''PALLETTE' LIGHTEST TO DARKEST
180 S1=1: REM SET TO 0() IF YOUR MID$ INDEXES FROM 0.
190 M1 = LEN (C$)
200 M2=4
210 L5 = -2.0
220 T1 = 1.25
230 X5 = 2.5
240 Y5 = -2.5
250 W = 38
260 H = 21
270 S2 = X5/W
280 S3 = Y5 / H
300 FOR Y = 0 TO H
310     C3 = Y * S3 + T1
320     FOR X = 0 TO W
330         C2 =X * S2 + L5
340         Z2 = 0
350         Z3 = 0
360         C1 = S1
370         X2 = Z2 * Z2
380         Y2 = Z3 * Z3
390         IF C1 > M1 THEN 460
400            IF (X2 - Y2) > M2 THEN 460
410            T = X2 - Y2 + C2
420            Z3 = 2 * Z2 * Z3 + C3
430            Z2 = T
440            C1 = C1 + 1
450            GOTO 370
460            PRINT MID$(C$, C1 - S1, 1);
470        NEXT X
480        PRINT
490    NEXT Y
520 END
